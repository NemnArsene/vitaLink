# ============================================================================
# VitaLink API Gateway - Environment Variables
# ============================================================================

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=vitalink-gateway

# Downstream APIs (Gateway is stateless — NO MongoDB)
HMS_API_URL=http://localhost:3001
IMS_API_URL=http://localhost:3002

# Shared JWT secret for inter-service communication
SERVICE_JWT_SECRET=shared-jwt-secret-change-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0

# JWT (stateless — no refresh tokens for MVP)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_ACCESS_EXPIRATION=15m

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Swagger
SWAGGER_ENABLED=true
